# ============================================================
# Variabili d'ambiente — Finanza Personale
# ============================================================
# Copia questo file in `.env` (dev locale) e su Vercel project
# settings → Environment Variables (produzione).
#
# Le var contrassegnate [PROD] sono richieste solo in produzione.
# Le [DEV] sono utili solo in dev locale.
# Le [BOTH] sono richieste sempre.
# ============================================================

# --- Database [BOTH] ---
# Produzione (Supabase Postgres):
#   DATABASE_URL = transaction pooler (port 6543 con ?pgbouncer=true)
#   DIRECT_URL   = direct/session connection (port 5432) — richiesta da
#                  Prisma per migrate/db push, NON dal runtime app.
# Dev locale (SQLite):
#   DATABASE_URL="file:./db.sqlite"
#   (DIRECT_URL può rimanere vuota; lo schema usa postgresql in prod)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Auth.js [BOTH] ---
# AUTH_SECRET: genera con `openssl rand -base64 32`. Cambialo se sospetti compromissione.
# AUTH_URL: URL pubblica dell'app. Deve essere HTTPS in prod, deve combaciare col dev (https://localhost:3000 per dev:https).
AUTH_SECRET="changemeplease-replace-with-random-32-bytes"
AUTH_URL="https://finanza-personale.vercel.app"

# --- Whitelist email [PROD] ---
# Lista email autorizzate a fare login (separate da virgola).
# Tutte le altre email vengono rifiutate dalla callback signIn in auth.ts.
# Vuoto/non impostato in dev = nessuna restrizione (chiunque può loggarsi).
AUTHORIZED_EMAILS="stefano.bonini.workmobile@gmail.com,stefano.bonini@rocketmail.com"

# --- Email magic link [PROD per email vere; vuoto in dev = console] ---
# In dev senza chiave: link stampato nel terminale (sufficiente).
# In prod con chiave: spedito via Resend (3.000 mail/mese gratis).
# EMAIL_FROM: usa il default Resend o un dominio verificato sul tuo account.
RESEND_API_KEY=""
EMAIL_FROM="Finanza Personale <onboarding@resend.dev>"

# --- Mercati: fallback Twelve Data [opzionale] ---
# Provider di fallback per Mercati quando Yahoo Finance restituisce HTTP 429.
# Free tier: 800 chiamate/giorno, 8/minuto. Per ottenerla:
#   1. Registrati gratis su https://twelvedata.com/register
#   2. Dashboard → API Keys → copia il valore
TWELVE_DATA_API_KEY=""

# --- Cron Vercel [PROD] ---
# Secret per autenticare le richieste cron Vercel (refresh prezzi notturno,
# sync PSD2). Genera con `openssl rand -base64 32`.
# Vercel imposta automaticamente l'header Authorization: Bearer <CRON_SECRET>
# nelle invocazioni cron schedulate.
CRON_SECRET="changemeplease-replace-with-random-32-bytes"

# --- PSD2 / Open Banking (Enable Banking) [PROD per uso PSD2] ---
# In dev locale tipicamente in `.env.local`. In prod (Vercel) servono qui:
# - APP_ID: identificativo applicazione su control.enablebanking.com
# - PRIVATE_KEY_PEM: il contenuto del file .pem (NON il path) — Vercel non
#   ha filesystem persistente, va incollata la chiave intera.
ENABLE_BANKING_APP_ID="a497439b-d6e2-4087-bdb3-83c058e3693d"
ENABLE_BANKING_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----
[INCOLLA QUI IL CONTENUTO DEL FILE .pem]
-----END RSA PRIVATE KEY-----"
