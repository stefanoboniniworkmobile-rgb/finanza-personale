# --- Database ---
# Locale (default): SQLite, file db.sqlite nella cartella prisma/
DATABASE_URL="file:./db.sqlite"
# Quando crei Supabase, sostituisci con la connection string Postgres:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[ref].supabase.co:5432/postgres"

# --- Auth.js ---
# Genera con: openssl rand -base64 32
AUTH_SECRET="changemeplease-replace-with-random-32-bytes"
AUTH_URL="http://localhost:3000"

# --- Email magic link ---
# Provider: Nodemailer. In dev, se RESEND_API_KEY è vuota, il link viene
# stampato in console (utile per sviluppo, niente SMTP da configurare).
# In produzione: registrati su https://resend.com (gratis fino a 3.000 email/mese,
# poi $20/mese per 50k email), prendi l'API key e incollala qui.
# EMAIL_FROM deve essere un dominio verificato su Resend (in dev va bene il
# default onboarding@resend.dev).
RESEND_API_KEY=""
EMAIL_FROM="Finanza Personale <onboarding@resend.dev>"

# --- Mercati: fallback Twelve Data ---
# Provider usato come fallback quando Yahoo Finance restituisce HTTP 429
# (rate limit) durante "Aggiorna tutto" o singoli refresh asset. Yahoo è
# gratuito ma ufficioso e a volte blocca per qualche minuto.
#
# Free tier Twelve Data: 800 chiamate/giorno, 8 al minuto. Sufficiente per
# uso personale. Per ottenere la chiave:
#   1. Registrati gratis su https://twelvedata.com/register
#   2. Conferma email
#   3. Dashboard → API Keys → copia il valore
#   4. Incolla qui sotto
# Se la lasci vuota, il fallback è disabilitato: in caso di 429 Yahoo il
# refresh fallisce con messaggio "API key non configurata".
TWELVE_DATA_API_KEY=""
